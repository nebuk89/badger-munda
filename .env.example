IP_RATE_LIMIT_HMAC_KEY=replace-with-a-different-random-secret
CONTENT_CATALOG_URL=https://your-public-blob.example/content/v1/catalog-hash/catalog.json
CONTENT_BLOB_BASE_URL=https://your-public-blob.example
